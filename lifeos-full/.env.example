# === __DA_NAME__ — ambiente do __PRINCIPAL_NAME__ (TEMPLATE; copie para .env e preencha) ===
# NÃO commitar o .env real. Fica fora da imagem Docker; entra via env_file no compose.

# --- Bot do __PRINCIPAL_NAME__ (criado pelo operador no @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Usuários liberados: __PRINCIPAL_NAME__ (__PRINCIPAL_CHAT_ID__) + operador/admin (__ADMIN_CHAT_ID__). Vírgula-separado.
# ⚠️ Nome exato = TELEGRAM_ALLOWED_USERS (telegram.ts), não _CHAT_IDS.
TELEGRAM_ALLOWED_USERS=

# --- Cérebro: OAUTH-PONTE na assinatura do operador ---
# ⚠️ DÍVIDA: trocar pelo CLAUDE_CODE_OAUTH_TOKEN do __PRINCIPAL_NAME__ e `docker compose up -d --force-recreate`.
# Gerar com `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Voz do __DA_NAME__ (Adam = PLACEHOLDER inglês; trocar por voz pt-BR do __PRINCIPAL_NAME__) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# --- Transcrição de áudio (Groq; reusada do operador por ora, trocar pela do __PRINCIPAL_NAME__) ---
GROQ_API_KEY=

# --- Vault do __PRINCIPAL_NAME__ (começa vazio, cresce com o uso) ---
LIFEOS_VAULT_DIR=/home/__TENANT__/vault
