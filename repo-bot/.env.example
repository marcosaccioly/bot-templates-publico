# === __BOT_DISPLAY_NAME__ (__TENANT__) — TEMPLATE; copie para .env e preencha ===
# NÃO commitar o .env real. Fica fora da imagem Docker; entra via env_file no compose.

# --- Bot (criado no @BotFather) ---
TELEGRAM_BOT_TOKEN=
# chat_ids autorizados em DM, vírgula-separado (equipe do cliente + operador).
TELEGRAM_ALLOWED_USERS=
# Grupos liberados (chat_ids NEGATIVOS, vírgula-separado). Vazio = bot ignora grupos.
# Grupo desconhecido loga "mensagem em grupo não autorizado" com o chat_id — copie daí.
# Em grupo o bot só acorda com @menção, o NOME dele, reply a ele ou /comando.
# ⚠️ Se o grupo virar supergrupo (admin, histórico visível), o id muda pra -100…: atualize.
# No BotFather: /setjoingroups = Enable; /setprivacy = Disable (senão nem o nome chega).
TELEGRAM_ALLOWED_GROUPS=
# Quem é quem (nome que o modelo vê + papel). chat_id:Nome:papel, vírgula-separado.
BOT_ROSTER=

# --- Cérebro: assinatura Claude do cliente (gerar com `claude setup-token`) ---
CLAUDE_CODE_OAUTH_TOKEN=

# --- Transcrição de áudio (Groq Whisper) ---
GROQ_API_KEY=

# --- Voz de saída (opcional; sem as duas chaves a voz fica desligada) ---
# ELEVENLABS_API_KEY=
# BOT_VOICE_ID=
# VOICE_ENABLED=0       # desliga tudo
# VOICE_AUTO=1          # resumo falado de toda resposta no privado (padrão: só <falar> sob pedido)
# VOICE_IN_GROUPS=1     # resumo automático também em grupo

# --- Reações (padrão ligado) ---
# REACTIONS_ENABLED=0

# --- Overrides opcionais (defaults no docker-compose.yml / run.ts) ---
# BOT_MODEL=claude-sonnet-5
# BOT_FALLBACK_MODEL=claude-opus-4-8
# BOT_MAX_TURNS=40
# Watchdog do turno: aborta só após silêncio REAL do SDK + teto absoluto.
# BOT_SDK_INACTIVITY_MS=180000
# BOT_SDK_HARD_CAP_MS=900000
