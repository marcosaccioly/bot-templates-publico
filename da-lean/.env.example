# === Assistente do(a) __PRINCIPAL_NAME__ (__DA_NAME__) — TEMPLATE; copie para .env e preencha ===
# NÃO commitar o .env real. Fica fora da imagem Docker; entra via env_file no compose.

# --- Bot (criado no @BotFather) ---
TELEGRAM_BOT_TOKEN=
# chat_ids autorizados, vírgula-separado. Nome exato = TELEGRAM_ALLOWED_USERS.
TELEGRAM_ALLOWED_USERS=

# --- Cérebro: billing direto via API key paga (SEM assinatura/OAuth-ponte) ---
ANTHROPIC_API_KEY=

# --- Transcrição de áudio (Groq Whisper) ---
GROQ_API_KEY=

# --- Workspace: repos clonados no boot (alias=owner/repo, separado por espaço).
#     alias = Host no ssh-seed/config = nome da pasta. Deploy key por repo
#     (ver deploy-keys/README.md). Vazio = nenhum clone automático. ---
WORKSPACE_REPOS=

# --- Alternativa às deploy keys: fine-grained PAT ESCOPADO só aos repos do
#     workspace (Contents:read+write). Se setado, clones/push viram HTTPS e o
#     ssh-seed/deploy-keys ficam sem uso. NUNCA um token da conta inteira. ---
# GIT_HTTPS_TOKEN=
# Workspace com repos de MAIS DE UMA conta GitHub: um PAT escopado por
# dona/dono, "ownerA=tokenA ownerB=tokenB". O entrypoint grava um credential
# por owner e o clone embute o owner na URL — cada repo usa o token certo.
# GIT_HTTPS_TOKENS=

# --- Override opcional de modelo ---
# CLAUDE_MODEL=claude-sonnet-5

# --- Reações no Telegram: chegada pelo tipo da mensagem (⚡ urgente · ✍ áudio ·
#     👀 anexo · 🤔 pergunta · 🙏 agradecimento) + final escolhida pelo modelo
#     (marcador REACT). Ligadas por padrão; só desligue se o cliente pedir. ---
# REACTIONS_ENABLED=0

# --- Inbox de anexos (opcional): anexo do Telegram é copiado pelo CÓDIGO pra
#     $INBOX_DIR/anexos/ + nota-irmã criada pelo modelo, sem perguntar "o que
#     fazer com o arquivo". Aponte pra dentro de um dos repos do workspace
#     (ex.: /home/bot/workspace/<repo>/inbox) pra versionar junto. Vazio =
#     anexo fica no tmp e o modelo decide. ---
# INBOX_DIR=

# --- Watchdog do turno (opcional; defaults 180000 / 900000 ms): aborta só
#     após silêncio REAL do SDK (inatividade) + teto absoluto do turno. ---
# SDK_INACTIVITY_MS=180000
# SDK_HARD_CAP_MS=900000

# --- Identidade/roteador VERSIONADOS (opcional, recomendado): aponte
#     IDENTITY_DIR (no docker-compose) pra dentro de um repo do workspace
#     (o "cérebro" do tenant) e WORKSPACE_CLAUDE_SRC pro roteador versionado
#     nesse repo — o entrypoint materializa na raiz do workspace a cada boot.
#     Resultado: identidade+memória+roteador portáveis via git, sem depender
#     de volume. ---
# WORKSPACE_CLAUDE_SRC=

# Teto de turnos por mensagem do SDK (default 25)
#MAX_TURNS=50
